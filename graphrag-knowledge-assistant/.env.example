# ============================================================
# GraphRAG Knowledge Intelligence Assistant - Environment Config
# ============================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.
# ============================================================

# Application
APP_NAME=GraphRAG Knowledge Intelligence Assistant
APP_ENV=development
APP_DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Data storage paths (absolute paths recommended)
# These default to ./data/ relative to the project root.
# Change these if you want to store data on a specific drive.
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
CHROMA_DIR=./data/chroma
GRAPH_DIR=./data/graph
PROCESSED_DIR=./data/processed
SQLITE_DB_PATH=./data/graphrag.db

# LLM (not used yet — will be configured in a later stage)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# Embeddings (not used yet — will be configured in a later stage)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
